{
  "name": "spa-grace-frontend",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "tw": "npx @tailwindcss/cli -i src/styles.css -o src/styles.tw.css --minify",
    "tw:watch": "npx @tailwindcss/cli -i src/styles.css -o src/styles.tw.css --minify --watch",
    "prestart": "npm run tw",
    "start": "ng serve",
    "prebuild": "npm run tw",
    "build": "ng build",
    "start:dev": "npm run tw && ng serve & npm run tw:watch",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "apexcharts": "^6.5.0",
    "ng-apexcharts": "^2.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
