# Entorno de Desarrollo
NODE_ENV=development
PORT=3000

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spa_consultorio_db

# JWT
JWT_SECRET=cambiar-por-clave-segura-de-256-bits
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-por-otra-clave-diferente
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Throttle (Rate Limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Swagger
SWAGGER_ENABLED=true
